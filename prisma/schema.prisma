// PERICO ERP — Prisma schema
// Stack note: Prisma 7 `prisma-client` generator (ESM). Import from "@/generated/prisma/client".
// DB: PostgreSQL (Supabase in production). Connection string lives in DATABASE_URL
//     (see prisma.config.ts). Driver adapter: @prisma/adapter-pg (PrismaPg).
//   - status/role fields are validated Strings (see src/lib/enums.ts)
//   - all money is stored as Int (whole BDT taka)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Multi-tenancy
// ----------------------------------------------------------------------------
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("TRIAL")   // TRIAL | STARTER | BUSINESS | PRO
  status    String   @default("ACTIVE")  // ACTIVE | SUSPENDED
  trialEndsAt      DateTime?              // end of free trial (set at signup)
  currentPeriodEnd DateTime?              // end of current paid subscription period

  // Business profile — appears on invoices, quotations & purchase orders
  businessType  String   @default("CLOTHING") // CLOTHING | GROCERY | PHARMACY | GENERAL
  legalName     String?
  email         String?
  phone         String?
  address       String?
  logoUrl       String?
  invoicePrefix String   @default("SO")
  taxRatePct    Int      @default(0)      // VAT/tax percentage applied to sales, e.g. 15
  taxLabel      String   @default("VAT")  // label shown on invoices
  currency      String   @default("BDT")
  invoiceFooter String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  categories     Category[]
  products       Product[]
  warehouses     Warehouse[]
  suppliers      Supplier[]
  customers      Customer[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  ledgerAccounts LedgerAccount[]
  quotations     Quotation[]
  salesReturns   SalesReturn[]
  auditLogs      AuditLog[]
  stockBatches   StockBatch[]
  expenses       Expense[]
  payments       Payment[]
}

// ----------------------------------------------------------------------------
// Auth
// ----------------------------------------------------------------------------
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  role            String   @default("STAFF") // ADMIN | MANAGER | STAFF
  active          Boolean  @default(true)
  sessionVersion  Int      @default(0)       // incremented on password change to invalidate old JWTs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Password reset (forgot-password flow): SHA-256 hash of the emailed token.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  passwordChangedAt DateTime? // set on every password change/reset

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  ledgerEntries  LedgerEntry[]
  quotations     Quotation[]
  salesReturns   SalesReturn[]
  auditLogs      AuditLog[]
  expenses       Expense[]

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String
  createdAt DateTime  @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  products Product[]

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String
  sku         String
  description String?
  gender      String   @default("UNISEX") // MEN | WOMEN | UNISEX | KIDS (clothing only)
  season      String?
  material    String?
  brand       String?  // generic attribute (grocery/pharma/general)
  unit        String?  // unit of measure, e.g. pcs, kg, box, strip
  costPrice   Int      @default(0) // BDT
  sellPrice   Int      @default(0) // BDT
  targetStock Int      @default(0) // desired stock level (0 = not set); for restock planning
  trackExpiry Boolean  @default(false) // enables batch/expiry tracking (Phase 2)
  imageUrl    String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants Variant[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
}

model Variant {
  id                String   @id @default(cuid())
  sku               String   @unique
  barcode           String?  @unique
  size              String // XS | S | M | L | XL | XXL | numeric
  color             String
  colorHex          String? // for the color swatch
  lowStockThreshold Int      @default(8)
  createdAt         DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  poItems         POItem[]
  soItems         SOItem[]
  quoteItems      QuoteItem[]
  salesReturnItems SalesReturnItem[]
  batches         StockBatch[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ----------------------------------------------------------------------------
// Batch + expiry tracking (for trackExpiry products: pharmacy, grocery, etc.)
// ----------------------------------------------------------------------------
model StockBatch {
  id          String    @id @default(cuid())
  batchNumber String?
  expiryDate  DateTime?
  quantity    Int       @default(0) // quantity received in this batch
  note        String?
  createdAt   DateTime  @default(now())

  tenantId    String
  variantId   String
  warehouseId String

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([variantId])
  @@index([expiryDate])
}

// ----------------------------------------------------------------------------
// Warehouses & stock
// ----------------------------------------------------------------------------
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  salesReturns   SalesReturn[]
  stockBatches   StockBatch[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model StockLevel {
  id          String @id @default(cuid())
  quantity    Int    @default(0)
  variantId   String
  warehouseId String

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id            String   @id @default(cuid())
  type          String // PURCHASE_IN | SALE_OUT | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT | RETURN_IN
  quantity      Int // signed: positive = in, negative = out
  reason        String?
  referenceType String? // PURCHASE_ORDER | SALES_ORDER | MANUAL | TRANSFER | RETURN
  referenceId   String?
  createdAt     DateTime @default(now())

  variantId   String
  warehouseId String
  userId      String?

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([variantId])
  @@index([warehouseId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Purchasing
// ----------------------------------------------------------------------------
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  poNumber     String
  status       String    @default("DRAFT") // DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELLED
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?
  totalAmount  Int       @default(0) // BDT
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  supplierId  String
  warehouseId String
  userId      String?

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  items POItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model POItem {
  id          String @id @default(cuid())
  quantity    Int
  unitCost    Int // BDT
  receivedQty Int    @default(0)

  purchaseOrderId String
  variantId       String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       Variant       @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
}

// ----------------------------------------------------------------------------
// Sales
// ----------------------------------------------------------------------------
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  salesOrders SalesOrder[]
  quotations  Quotation[]

  @@index([tenantId])
}

model SalesOrder {
  id            String   @id @default(cuid())
  orderNumber   String
  status        String   @default("DRAFT")  // DRAFT | CONFIRMED | FULFILLED | CANCELLED
  paymentStatus String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  amountPaid    Int      @default(0)
  orderDate     DateTime @default(now())
  subtotal      Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  total         Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  customerId  String?
  warehouseId String
  userId      String?

  customer  Customer?  @relation(fields: [customerId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  items       SOItem[]
  salesReturns SalesReturn[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([orderDate])
}

model SOItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Int // BDT

  salesOrderId String
  variantId    String

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  variant    Variant    @relation(fields: [variantId], references: [id])

  @@index([salesOrderId])
}

// ----------------------------------------------------------------------------
// Quotations
// ----------------------------------------------------------------------------
model Quotation {
  id          String    @id @default(cuid())
  quoteNumber String
  status      String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED
  quoteDate   DateTime  @default(now())
  validUntil  DateTime?
  subtotal    Int       @default(0)
  discount    Int       @default(0)
  total       Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])

  items QuoteItem[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

model QuoteItem {
  id          String @id @default(cuid())
  quantity    Int
  unitPrice   Int // BDT

  quotationId String
  variantId   String

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant   Variant   @relation(fields: [variantId], references: [id])

  @@index([quotationId])
}

// ----------------------------------------------------------------------------
// Sales Returns
// ----------------------------------------------------------------------------
model SalesReturn {
  id           String   @id @default(cuid())
  returnNumber String
  reason       String?
  notes        String?
  totalAmount  Int      @default(0) // BDT — total value of items returned
  createdAt    DateTime @default(now())

  tenantId     String
  salesOrderId String
  warehouseId  String
  userId       String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  items SalesReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([salesOrderId])
}

model SalesReturnItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Int // BDT — at original sale price

  salesReturnId String
  variantId     String

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  variant     Variant     @relation(fields: [variantId], references: [id])

  @@index([salesReturnId])
}

// ----------------------------------------------------------------------------
// Dena–Paona (Payables / Receivables ledger)
// ----------------------------------------------------------------------------
model LedgerAccount {
  id            String    @id @default(cuid())
  code          String    // P-1023 (Paona) / D-1023 (Dena)
  type          String // PAONA (they owe me) | DENA (I owe them)
  shopName      String
  ownerName     String?
  address       String?
  phone         String?
  category      String?
  notes         String?
  openingAmount Int       @default(0) // BDT — original due/payable at creation
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  entries LedgerEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
}

model LedgerEntry {
  id         String   @id @default(cuid())
  kind       String // PAYMENT (settles balance) | CHARGE (adds more due)
  amount     Int // BDT, positive
  method     String? // CASH | BANK | MOBILE | OTHER
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  ledgerId String
  userId   String?

  ledger LedgerAccount @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])

  @@index([ledgerId])
  @@index([occurredAt])
}

// ----------------------------------------------------------------------------
// Audit Log
// ----------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE | UPDATE | DELETE
  entity    String   // SalesOrder | PurchaseOrder | Product | StockMovement | etc.
  entityId  String
  entityRef String?  // human-readable reference e.g. SO-2025-0001
  changes   String?  // JSON string of what changed (key/value pairs)
  createdAt DateTime @default(now())

  tenantId String
  userId   String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entity])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Subscription payments (SaaS billing)
// ----------------------------------------------------------------------------
model Payment {
  id           String    @id @default(cuid())
  plan         String    // STARTER | BUSINESS | PRO
  amount       Int       // BDT
  periodMonths Int       @default(1)
  method       String    // MANUAL | SSLCOMMERZ
  status       String    @default("PENDING") // PENDING | PAID | FAILED
  reference    String?   // manual txn id, or gateway transaction/val id
  gatewaySessionId String?
  note         String?
  createdAt    DateTime  @default(now())
  paidAt       DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Expenses (operating costs — feeds the Profit & Loss report)
// ----------------------------------------------------------------------------
model Expense {
  id        String   @id @default(cuid())
  category  String   // RENT | SALARY | UTILITIES | TRANSPORT | MARKETING | SUPPLIES | OTHER
  amount    Int      // BDT
  note      String?
  method    String?  // CASH | BANK | MOBILE | OTHER
  spentAt   DateTime @default(now())
  createdAt DateTime @default(now())

  tenantId String
  userId   String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([spentAt])
}
