// PERICO ERP — Prisma schema
// Stack note: Prisma 7 `prisma-client` generator (ESM). Import from "@/generated/prisma/client".
// DB: PostgreSQL (Supabase in production). Connection string lives in DATABASE_URL
//     (see prisma.config.ts). Driver adapter: @prisma/adapter-pg (PrismaPg).
//   - status/role fields are validated Strings (see src/lib/enums.ts)
//   - all money is stored as Int (whole BDT taka)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Multi-tenancy
// ----------------------------------------------------------------------------
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("TRIAL")   // TRIAL | STARTER | BUSINESS | PRO
  status    String   @default("ACTIVE")  // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  categories     Category[]
  products       Product[]
  warehouses     Warehouse[]
  suppliers      Supplier[]
  customers      Customer[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  ledgerAccounts LedgerAccount[]
}

// ----------------------------------------------------------------------------
// Auth
// ----------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // ADMIN | MANAGER | STAFF
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password reset (forgot-password flow): SHA-256 hash of the emailed token.
  resetTokenHash   String?
  resetTokenExpiry DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  ledgerEntries  LedgerEntry[]

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String
  createdAt DateTime  @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  products Product[]

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String
  sku         String
  description String?
  gender      String   @default("UNISEX") // MEN | WOMEN | UNISEX | KIDS
  season      String?
  material    String?
  costPrice   Int      @default(0) // BDT
  sellPrice   Int      @default(0) // BDT
  imageUrl    String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants Variant[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
}

model Variant {
  id                String   @id @default(cuid())
  sku               String   @unique
  barcode           String?  @unique
  size              String // XS | S | M | L | XL | XXL | numeric
  color             String
  colorHex          String? // for the color swatch
  lowStockThreshold Int      @default(8)
  createdAt         DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  poItems        POItem[]
  soItems        SOItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ----------------------------------------------------------------------------
// Warehouses & stock
// ----------------------------------------------------------------------------
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model StockLevel {
  id          String @id @default(cuid())
  quantity    Int    @default(0)
  variantId   String
  warehouseId String

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id            String   @id @default(cuid())
  type          String // PURCHASE_IN | SALE_OUT | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT
  quantity      Int // signed: positive = in, negative = out
  reason        String?
  referenceType String? // PURCHASE_ORDER | SALES_ORDER | MANUAL | TRANSFER
  referenceId   String?
  createdAt     DateTime @default(now())

  variantId   String
  warehouseId String
  userId      String?

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([variantId])
  @@index([warehouseId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Purchasing
// ----------------------------------------------------------------------------
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  poNumber     String
  status       String    @default("DRAFT") // DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELLED
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?
  totalAmount  Int       @default(0) // BDT
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  supplierId  String
  warehouseId String
  userId      String?

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  items POItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model POItem {
  id          String @id @default(cuid())
  quantity    Int
  unitCost    Int // BDT
  receivedQty Int    @default(0)

  purchaseOrderId String
  variantId       String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       Variant       @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
}

// ----------------------------------------------------------------------------
// Sales
// ----------------------------------------------------------------------------
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  salesOrders SalesOrder[]

  @@index([tenantId])
}

model SalesOrder {
  id          String   @id @default(cuid())
  orderNumber String
  status      String   @default("DRAFT") // DRAFT | CONFIRMED | FULFILLED | CANCELLED
  orderDate   DateTime @default(now())
  subtotal    Int      @default(0)
  discount    Int      @default(0)
  tax         Int      @default(0)
  total       Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  customerId  String?
  warehouseId String
  userId      String?

  customer  Customer?  @relation(fields: [customerId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  items SOItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([orderDate])
}

model SOItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Int // BDT

  salesOrderId String
  variantId    String

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  variant    Variant    @relation(fields: [variantId], references: [id])

  @@index([salesOrderId])
}

// ----------------------------------------------------------------------------
// Dena–Paona (Payables / Receivables ledger)
// ----------------------------------------------------------------------------
model LedgerAccount {
  id            String    @id @default(cuid())
  code          String    // P-1023 (Paona) / D-1023 (Dena)
  type          String // PAONA (they owe me) | DENA (I owe them)
  shopName      String
  ownerName     String?
  address       String?
  phone         String?
  category      String?
  notes         String?
  openingAmount Int       @default(0) // BDT — original due/payable at creation
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  entries LedgerEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
}

model LedgerEntry {
  id         String   @id @default(cuid())
  kind       String // PAYMENT (settles balance) | CHARGE (adds more due)
  amount     Int // BDT, positive
  method     String? // CASH | BANK | MOBILE | OTHER
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  ledgerId String
  userId   String?

  ledger LedgerAccount @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])

  @@index([ledgerId])
  @@index([occurredAt])
}
