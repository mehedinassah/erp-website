# ─────────────────────────────────────────────────────────────────────
# PERICO ERP — environment variables
# Copy this file to `.env` for local dev, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase).
# Use the **pooled** connection (port 6543, "Transaction" pooler) for the app
# running on Vercel serverless. Example shape:
#   postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# For `prisma db push` / seeding, the **direct** connection (port 5432).
# Only used by CLI tooling, not the running app.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secret used to sign session JWTs. MUST be a long random string in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
